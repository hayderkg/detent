{
  "name": "detent",
  "version": "0.0.0",
  "description": "A wheel picker for React that clicks into place.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hayderkg/detent.git"
  },
  "homepage": "https://github.com/hayderkg/detent#readme",
  "bugs": {
    "url": "https://github.com/hayderkg/detent/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./feedback": {
      "import": {
        "types": "./dist/feedback.d.ts",
        "default": "./dist/feedback.js"
      },
      "require": {
        "types": "./dist/feedback.d.cts",
        "default": "./dist/feedback.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "dev": "tsup --watch",
    "size": "size-limit",
    "test:react18": "vitest run --config vitest.react18.config.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
