[
  {
    "name": "core: useDetent (physics + engine + hook)",
    "path": "dist/index.js",
    "import": "{ useDetent }",
    "gzip": true,
    "limit": "6.3 kB",
    "ignore": [
      "react",
      "react-dom"
    ]
  },
  {
    "name": "<Detent> (styled component, includes core + feedback)",
    "path": "dist/index.js",
    "import": "{ Detent }",
